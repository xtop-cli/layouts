{
    // Math Lab: four runtime widgets, each doing statistics in a different
    // language and rendering the result through the draw-list contract.
    //
    // Requirements: a kernel built with `--features plugin-wasm,plugin-external`
    // and the example widgets from https://github.com/xtop-cli/plugins
    // (examples/wasm + examples/external) installed in the user config dirs.
    //
    //   py-mem-regression  Python  least-squares fit, R^2, slope, 60s projection
    //   lua-histogram      Lua     frequency histogram + mean/sigma/p95
    //   wasm-load-stats    Rust->WASM  load history, EMA and z-score
    //   c-cpu-avg          C (freestanding)  per-core mean/min/max bars
    //
    // Install this layout with `xtop layout install math_lab`.
    "name": "Math Lab",
    "root": {
        "direction": "vertical",
        "areas": [
            { "widget": "header", "size": 3 },
            {
                "direction": "horizontal",
                "size": "50%",
                "areas": [
                    { "widget": "py-mem-regression", "size": "50%" },
                    { "widget": "lua-histogram", "size": "50%" }
                ]
            },
            {
                "direction": "horizontal",
                "size": "*",
                "areas": [
                    { "widget": "wasm-load-stats", "size": "50%" },
                    { "widget": "c-cpu-avg", "size": "50%" }
                ]
            }
        ]
    }
}
