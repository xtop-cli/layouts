{
    // WASM Demo: runtime widgets provided outside the kernel.
    //
    // Requirements: a kernel built with `--features plugin-wasm,plugin-external`
    // and the example widgets from https://github.com/xtop-cli/plugins
    // (examples/wasm + examples/external) installed in the user config dirs.
    //
    //   wasm-clock / wasm-cpu / wasm-procs  sandboxed WASM modules
    //   lua-clock / py-cpu                  Lua and Python helper processes
    //
    // Install this layout with `xtop layout install wasm-demo`.
    "name": "WASM Demo",
    "root": {
        "direction": "vertical",
        "areas": [
            { "widget": "header", "size": 3 },
            {
                "direction": "horizontal",
                "size": "28%",
                "areas": [
                    { "widget": "wasm-clock", "size": "50%" },
                    { "widget": "lua-clock", "size": "50%" }
                ]
            },
            {
                "direction": "horizontal",
                "size": "36%",
                "areas": [
                    { "widget": "wasm-cpu", "size": "50%" },
                    { "widget": "py-cpu", "size": "50%" }
                ]
            },
            { "widget": "wasm-procs", "size": "*" }
        ]
    }
}
